# ============================================
# PulseGuard Flask API Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!
# ============================================

# --------------------------------------------
# Firebase
# --------------------------------------------
# Realtime Database URL (not a secret, but keep it here)
FIREBASE_URL=https://pulseguard-7ae33-default-rtdb.firebaseio.com/

# Firebase Web API Key - REQUIRED for login (Admin/Technical dashboards)
# Firebase Console > Project settings (gear) > General > Web API key
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Comma-separated emails that get the 'admin' role on first login.
# Everyone else gets the 'technical' role.
ADMIN_EMAILS=admin@123gmail.com

# --------------------------------------------
# Flask
# --------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-in-production

# Background live-prediction poller
POLLING_INTERVAL_SECONDS=10

# --------------------------------------------
# Email alerts (Gmail requires an App Password:
# Google Account > Security > 2-Step Verification > App passwords)
# --------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=24uca143@anjaconline.org
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# Admin/Owner recipient (critical alerts + service updates)
MAIL_RECIPIENT=YOUR_RECIPIENT@gmail.com
# Technical Team recipient (critical alerts)
MAIL_TECH_RECIPIENT=YOUR_TECH_TEAM@gmail.com
MAIL_SENDER=24uca143@anjaconline.org

# Anti-spam cooldown for CRITICAL alerts (seconds)
ALERT_COOLDOWN_SECONDS=3600

# Link included in emails for tracking service requests
DASHBOARD_URL=http://localhost:8000
